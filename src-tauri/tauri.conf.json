{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoxDen",
  "version": "0.14.1",
  "identifier": "com.foxden.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FoxDen",
        "width": 1180,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false,
        "focus": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
