{
  "build": {
    "beforeBuildCommand": "cargo build --release -p foxden-service"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "../target/release/foxden-service.exe": "foxden-service.exe",
      "../packaging/PawnIO_setup.exe": "PawnIO_setup.exe",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../packaging/installer-hooks.nsh"
      }
    }
  }
}
