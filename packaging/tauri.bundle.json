{
  "build": {
    "beforeBuildCommand": "cargo build --release -p foxrgb-service"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "../target/release/foxrgb-service.exe": "foxrgb-service.exe",
      "../packaging/PawnIO_setup.exe": "PawnIO_setup.exe",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../packaging/installer-hooks.nsh"
      }
    }
  }
}
