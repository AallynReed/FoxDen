import { Theme, I18n, Tab } from "widgets.slint";
import { EffectsPage, EffectsPanel } from "effects.slint";
import { DevicesPage, DevicesPanel } from "devices.slint";
import { FansPage, FansPanel } from "fans.slint";
import { AudioPage, AudioPanel } from "audio.slint";
import { ProfilesPage, ProfilesPanel } from "profiles.slint";
import { SettingsPage, SettingsPanel } from "settings.slint";
import { StagePage, Stage } from "stage.slint";

export { Theme, I18n, EffectsPage, DevicesPage, FansPage, AudioPage, ProfilesPage, SettingsPage, StagePage }

export component AppWindow inherits Window {
    title: "FoxDen";
    icon: @image-url("../../src-tauri/icons/32x32.png");
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 520px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    in-out property <int> tab: 0;
    out property <length> canvas-width: stage.canvas-width;
    out property <length> canvas-height: stage.canvas-height;

    HorizontalLayout {
        Rectangle {
            min-width: 320px;
            max-width: 380px;
            horizontal-stretch: 0.3;
            background: Theme.panel;
            VerticalLayout {
                HorizontalLayout {
                    height: 44px;
                    Tab { name: I18n.t("Effects"); selected: root.tab == 0; activate => { root.tab = 0; }
                        icon: "M8 1.5l1.6 4.9 4.9 1.6-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6z"; }
                    Tab { name: I18n.t("Devices"); selected: root.tab == 1; activate => { root.tab = 1; }
                        icon: "M1.5 4.5h13v7h-13zM4 7h1M7.5 7h1M11 7h1M4.5 9.5h7"; }
                    Tab { name: I18n.t("Fans"); selected: root.tab == 2; activate => { root.tab = 2; }
                        icon: "M6.7 8 A1.3 1.3 0 1 0 9.3 8 A1.3 1.3 0 1 0 6.7 8 M8.9 7C9.8 4.4 9.2 1.9 7.2 2 5.4 2.1 5.6 4.6 7 6.8";
                        icon2: "M8.42 9.28 C10.22 11.36 12.68 12.09 13.60 10.31 C14.41 8.70 12.14 7.62 9.54 7.73";
                        icon3: "M6.68 7.72 C3.98 8.24 2.12 10.01 3.20 11.69 C4.19 13.20 6.26 11.78 7.46 9.47"; }
                    Tab { name: I18n.t("Audio"); selected: root.tab == 3; activate => { root.tab = 3; }
                        icon: "M1.5 6h3l4-3v10l-4-3h-3zM11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.5a6.4 6.4 0 0 1 0 9"; }
                    Tab { name: I18n.t("Profiles"); selected: root.tab == 4; activate => { root.tab = 4; }
                        icon: "M8 2l6.5 3.5L8 9 1.5 5.5zM1.5 8.5L8 12l6.5-3.5M1.5 11.2L8 14.7l6.5-3.5"; }
                    Tab { name: I18n.t("Settings"); selected: root.tab == 5; activate => { root.tab = 5; }
                        icon: "M6 8 A2 2 0 1 0 10 8 A2 2 0 1 0 6 8 M3.4 8 A4.6 4.6 0 1 0 12.6 8 A4.6 4.6 0 1 0 3.4 8";
                        icon2: "M8 .8v2.6M8 12.6v2.6M.8 8h2.6M12.6 8h2.6M2.9 2.9l1.8 1.8M11.3 11.3l1.8 1.8M2.9 13.1l1.8-1.8M11.3 4.7l1.8-1.8"; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.tab == 0: EffectsPanel { }
                if root.tab == 1: DevicesPanel { }
                if root.tab == 2: FansPanel { }
                if root.tab == 3: AudioPanel { }
                if root.tab == 4: ProfilesPanel { }
                if root.tab == 5: SettingsPanel { }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        stage := Stage { }
    }
}
