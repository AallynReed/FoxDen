import { Theme, I18n, Cut, Heading, Hint, Button, Slider, Toggle, Select, Field, Pick, Scroll, EffectItem, Param, DeviceItem, CanvasLabel, Line } from "widgets.slint";

export global DevicesPage {
    in property <[DeviceItem]> devices;
    in property <[Line]> detected;
    in property <bool> auto-detect;
    callback select-device(string);
    callback set-device-enabled(string, bool);
    callback set-device-brightness(string, float);
    callback detect-now();
    callback rescan();
    callback set-auto-detect(bool);
}

export component DevicesPanel inherits Scroll {
    content-height: devices-body.preferred-height;
    devices-body := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Heading { text: I18n.t("Devices"); }
        if DevicesPage.devices.length == 0: Hint { text: I18n.t("No devices found. Check the backends under Settings, then rescan."); }
        for d in DevicesPage.devices: Rectangle {
            height: d.selected ? 76px : 44px;
            background: d.selected ? Theme.raised : row.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: d.selected ? Theme.accent : Theme.line;
            accessible-role: list-item;
            accessible-label: d.name;
            accessible-item-selectable: true;
            accessible-item-selected: d.selected;
            row := TouchArea {
                clicked => { DevicesPage.select-device(d.id); }
            }
            Text {
                x: 12px;
                y: 4px;
                width: parent.width - 72px;
                text: d.name;
                color: d.enabled ? Theme.text : Theme.muted;
                overflow: elide;
            }
            Text {
                x: 12px;
                y: 22px;
                text: d.backend;
                color: Theme.muted;
                font-size: 12px;
            }
            Toggle {
                x: parent.width - 48px;
                y: 12px;
                on: d.enabled;
                label: d.name;
                toggled(v) => { DevicesPage.set-device-enabled(d.id, v); }
            }
            if d.selected: HorizontalLayout {
                x: 12px;
                y: 44px;
                width: parent.width - 24px;
                height: 24px;
                spacing: 8px;
                Text { text: I18n.t("Brightness"); color: Theme.muted; vertical-alignment: center; }
                Slider {
                    label: I18n.t("Brightness");
                    value: d.brightness;
                    changed(v) => { DevicesPage.set-device-brightness(d.id, v); }
                }
                Text {
                    width: 40px;
                    text: round(d.brightness * 100) + "%";
                    color: Theme.text;
                    font-family: Theme.mono;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        Hint { text: I18n.t("Select a device to set its brightness, or drag it on the canvas. Arrow keys move the selected device by 1% of the canvas, Ctrl+arrow keys by 5%. With Shift they resize it instead."); }

        Heading { text: I18n.t("Detected hardware"); }
        HorizontalLayout {
            spacing: 8px;
            Text { text: I18n.t("Automatic detection"); color: Theme.text; vertical-alignment: center; }
            Toggle { on: DevicesPage.auto-detect; label: I18n.t("Automatic detection"); toggled(v) => { DevicesPage.set-auto-detect(v); } }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { text: I18n.t("Detect now"); clicked => { DevicesPage.detect-now(); } }
        }
        if DevicesPage.detected.length == 0: Hint { text: I18n.t("No lighting hardware detected yet."); }
        for l in DevicesPage.detected: VerticalLayout {
            Text { text: l.title; color: l.ok ? Theme.text : Theme.muted; overflow: elide; }
            Hint { text: l.detail; }
        }
    }
}
